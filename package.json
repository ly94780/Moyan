{
  "name": "moyan-markdown",
  "version": "0.2.4",
  "description": "墨页 · 离线 Markdown 阅读编辑器",
  "author": "Moyan",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "build": "npm run typecheck && electron-vite build",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "postinstall": "npm run install:runtime && electron-builder install-app-deps",
    "install:runtime": "node node_modules/electron/install.js"
  },
  "build": {
    "appId": "local.moyan.markdown",
    "productName": "墨页",
    "directories": {
      "output": "release/0.2.4"
    },
    "files": [
      "out/**/*",
      "package.json",
      "resources/**/*"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Moyan.Markdown",
        "description": "Markdown 文档",
        "role": "Editor"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Moyan-${version}-Setup.${ext}",
      "icon": "resources/moyan.ico",
      "signExecutable": false
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "resources/moyan.ico",
      "uninstallerIcon": "resources/moyan.ico"
    },
    "electronDist": "node_modules/electron/dist"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.15",
    "lucide-react": "1.76.0",
    "mdast-util-to-string": "4.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-highlight": "7.0.2",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "electron-vite": "4.0.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "26.1.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "7.3.8",
    "vitest": "5.1.1"
  },
  "overrides": {
    "app-builder-lib": {
      "minimatch": "11.0.1"
    },
    "@electron/universal": {
      "minimatch": "11.0.1"
    }
  },
  "license": "UNLICENSED"
}
